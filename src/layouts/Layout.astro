---
import "../styles/global.css";
import { SITE } from "../data/members";
---

<!doctype html>
<html lang="en" data-theme="mocha">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.name} — {SITE.meta}</title>
    <meta name="description" content={SITE.tagline} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Set theme BEFORE first paint → no flash. Order: saved choice › OS preference › mocha. -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const prefersLight = matchMedia("(prefers-color-scheme: light)").matches;
        const theme = saved ?? (prefersLight ? "latte" : "mocha");
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
