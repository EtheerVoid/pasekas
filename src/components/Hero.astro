---
import { SITE } from "../data/members";
---

<header class="hero">
  <canvas id="gl" aria-hidden="true"></canvas>
  <div class="hero__inner wrap">
    <p class="eyebrow">fastfetch --members --everyone</p>
    <h1 class="hero__title">{SITE.name}</h1>
    <p class="hero__tag">{SITE.tagline}</p>
    <a class="hero__scroll" href="#roster">▼ scroll the roster</a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: hidden;
  }
  #gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-4);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin: 0.3em 0 0.25em;
    color: var(--text);
    overflow-wrap: anywhere;
    text-wrap: balance;
    mix-blend-mode: var(--blend, normal);
  }
  .hero__tag {
    max-width: 44ch;
    color: var(--subtext);
    font-size: var(--step-1);
  }
  .hero__scroll {
    display: inline-block;
    margin-top: 2.5rem;
    text-decoration: none;
    color: var(--text);
    border: 1px solid var(--surface1);
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--base) 55%, transparent);
    backdrop-filter: blur(6px);
    transition: border-color 0.2s, transform 0.2s;
  }
  .hero__scroll:hover { border-color: var(--mauve); transform: translateY(-2px); }
</style>

<script>
  const canvas = document.getElementById("gl") as HTMLCanvasElement | null;
  const gl = canvas?.getContext("webgl2", { antialias: false, alpha: false });

  if (canvas && gl) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const vert = `#version 300 es
    in vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }`;

    const frag = `#version 300 es
    precision highp float;
    out vec4 o;
    uniform vec2 u_res;
    uniform float u_time;
    uniform vec2 u_mouse;
    uniform vec3 c0; uniform vec3 c1; uniform vec3 c2; uniform vec3 c3;

    float hash(vec2 p){ p=fract(p*vec2(123.34,456.21)); p+=dot(p,p+45.32); return fract(p.x*p.y); }
    float noise(vec2 p){
      vec2 i=floor(p), f=fract(p);
      vec2 u=f*f*(3.0-2.0*f);
      return mix(mix(hash(i),hash(i+vec2(1,0)),u.x),
                 mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),u.x), u.y);
    }
    float fbm(vec2 p){ float v=0.0,a=0.5; for(int i=0;i<6;i++){ v+=a*noise(p); p=p*2.0+13.0; a*=0.5; } return v; }

    void main(){
      vec2 uv = gl_FragCoord.xy / u_res;
      vec2 p = uv * 2.4;
      p.x *= u_res.x / u_res.y;
      p += (u_mouse - 0.5) * 0.6;
      float t = u_time * 0.05;

      // domain warp — two folds for that liquid, flowing basement.studio feel
      vec2 q = vec2(fbm(p + t), fbm(p + vec2(5.2, 1.3)));
      vec2 r = vec2(fbm(p + 4.0*q + vec2(1.7, 9.2) + t),
                    fbm(p + 4.0*q + vec2(8.3, 2.8)));
      float f = fbm(p + 4.0*r);

      vec3 col = mix(c0, c1, clamp(f*f*2.4, 0.0, 1.0));
      col = mix(col, c2, clamp(length(q), 0.0, 1.0));
      col = mix(col, c3, clamp(r.x*r.x, 0.0, 1.0));
      col = mix(c0, col, 0.85);              // keep base readable behind text
      col += (hash(gl_FragCoord.xy) - 0.5) * 0.02; // dither, kills banding
      o = vec4(col, 1.0);
    }`;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, vert));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, frag));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    // one big triangle covering the screen
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, "p");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const U = {
      res: gl.getUniformLocation(prog, "u_res"),
      time: gl.getUniformLocation(prog, "u_time"),
      mouse: gl.getUniformLocation(prog, "u_mouse"),
      c: [0, 1, 2, 3].map((i) => gl.getUniformLocation(prog, "c" + i)),
    };

    // read catppuccin colors straight from the CSS variables → shader stays in sync with theme
    const hex2rgb = (h: string): [number, number, number] => {
      h = h.trim().replace("#", "");
      return [
        parseInt(h.slice(0, 2), 16) / 255,
        parseInt(h.slice(2, 4), 16) / 255,
        parseInt(h.slice(4, 6), 16) / 255,
      ];
    };
    const syncColors = () => {
      const cs = getComputedStyle(document.documentElement);
      const vars = ["--mantle", "--mauve", "--blue", "--pink"];
      vars.forEach((v, i) => gl.uniform3fv(U.c[i], hex2rgb(cs.getPropertyValue(v))));
    };
    new MutationObserver(syncColors).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    syncColors();

    const dpr = () => Math.min(devicePixelRatio || 1, 1.75);
    const resize = () => {
      const w = Math.floor(canvas.clientWidth * dpr());
      const h = Math.floor(canvas.clientHeight * dpr());
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl.viewport(0, 0, w, h);
      }
      gl.uniform2f(U.res, canvas.width, canvas.height);
    };
    addEventListener("resize", resize);
    resize();

    const mouse = [0.5, 0.5];
    addEventListener("pointermove", (e) => {
      mouse[0] = e.clientX / innerWidth;
      mouse[1] = 1 - e.clientY / innerHeight;
    }, { passive: true });

    let running = true;
    const draw = (ms: number) => {
      gl.uniform1f(U.time, ms * 0.001);
      gl.uniform2f(U.mouse, mouse[0], mouse[1]);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (running && !reduced) requestAnimationFrame(draw);
    };

    if (reduced) {
      // static single frame — respects reduced-motion
      gl.uniform1f(U.time, 12.0);
      gl.uniform2f(U.mouse, 0.5, 0.5);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    } else {
      requestAnimationFrame(draw);
      // pause when tab hidden — don't burn GPU in the background
      document.addEventListener("visibilitychange", () => {
        running = !document.hidden;
        if (running) requestAnimationFrame(draw);
      });
    }
  }
</script>
