---
import { MEMBERS } from "../data/members";
const quotes = MEMBERS.filter((m) => m.quote).map((m) => ({ q: m.quote!, who: m.handle }));
// duplicate the list so the marquee loops seamlessly
const loop = [...quotes, ...quotes];
---

<section class="wall" aria-label="inside jokes">
  <div class="wall__track">
    {loop.map((x) => (
      <span class="wall__item">
        <span class="wall__q">&ldquo;{x.q}&rdquo;</span>
        <span class="wall__who">— {x.who}</span>
      </span>
    ))}
  </div>
</section>

<style>
  .wall {
    border-block: 1px solid var(--surface0);
    background: var(--mantle);
    padding-block: 1.4rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .wall__track {
    display: flex;
    gap: 3rem;
    width: max-content;
    animation: scroll 38s linear infinite;
  }
  .wall:hover .wall__track { animation-play-state: paused; }
  .wall__item { display: inline-flex; gap: 0.7rem; align-items: baseline; white-space: nowrap; }
  .wall__q { color: var(--text); }
  .wall__who { color: var(--mauve); font-size: var(--step--1); }
  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wall__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
  }
</style>
