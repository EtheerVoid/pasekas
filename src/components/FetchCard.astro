---
import type { Member } from "../data/members";
const { m } = Astro.props as { m: Member };
---

<article class="card" style={`--accent: var(--${m.accent});`}>
  <pre class="card__sigil" aria-hidden="true">{m.sigil}</pre>
  <div class="card__body">
    <h3 class="card__head">
      <span class="card__user">{m.handle}</span><span class="card__at">@</span><span class="card__host">{m.host}</span>
    </h3>
    <div class="card__rule"></div>
    <dl class="card__specs">
      {m.specs.map(([k, v]) => (
        <div class="card__row">
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding: 1.4rem;
    background: var(--mantle);
    border: 1px solid var(--surface0);
    border-radius: 14px;
    position: relative;
    overflow: hidden;
  }
  /* accent glow strip — the only flashy bit, kept to one edge */
  .card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
    box-shadow: 0 0 14px var(--accent);
  }
  .card__sigil {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.25;
    color: var(--accent);
    white-space: pre;
    align-self: center;
    margin: 0;
  }
  .card__head { font-size: var(--step-1); font-weight: 700; }
  .card__user { color: var(--accent); }
  .card__at { color: var(--overlay0); }
  .card__host { color: var(--text); }
  .card__rule { height: 1px; background: var(--surface1); margin: 0.5rem 0 0.8rem; }
  .card__specs { display: grid; gap: 0.4rem; }
  .card__row { display: grid; grid-template-columns: 5.5rem 1fr; gap: 0.6rem; align-items: baseline; }
  .card__row dt { color: var(--subtext); font-weight: 500; }
  .card__row dd { color: var(--text); }

  @media (max-width: 520px) {
    .card { grid-template-columns: 1fr; }
    .card__sigil { font-size: 0.7rem; }
    .card__row { grid-template-columns: 4.5rem 1fr; }
  }
</style>
