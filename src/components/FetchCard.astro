---
import type { Member } from "../data/members";
const { m } = Astro.props as { m: Member };
---

<article class="card" style={`--accent: var(--${m.accent});`}>
  <p class="card__seal">◆ certified greatest</p>

  <div class="card__art">
    {m.image
      ? <img src={m.image} alt={m.handle} loading="lazy" />
      : <pre class="fit" aria-hidden="true">{m.sigil}</pre>}
  </div>

  <div class="card__id">
    <span class="card__user">{m.handle}</span><span class="card__at">@</span><span class="card__host">{m.host}</span>
  </div>

  <h3 class="card__title">{m.title}</h3>
  <div class="card__rule"></div>

  <dl class="card__specs">
    {m.specs.map(([k, v]) => (
      <div class="card__row"><dt>{k}</dt><dd>{v}</dd></div>
    ))}
  </dl>

  <p class="card__quote">&ldquo;{m.quote}&rdquo;</p>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--mantle);
    border: 1px solid var(--surface0);
    border-radius: 18px;
    overflow: hidden;
    height: 100%;
  }
  .card::after {
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 12px;
    pointer-events: none;
  }

  .card__seal {
    font-size: var(--step--1);
    color: var(--subtext);
    letter-spacing: 0.04em;
    text-align: center;
  }

  /* every picture lives in the SAME fixed square, regardless of source size */
  .card__art {
    width: 100%;
    max-width: 240px;
    aspect-ratio: 1 / 1;
    margin: clamp(1rem, 3vw, 1.8rem) auto;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .card__art .fit {
    font-family: var(--font-mono);
    line-height: 1;
    white-space: pre;
    margin: 0;
    color: var(--accent);
    transform-origin: center center;
    text-shadow: 0 0 16px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .card__art img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 14px color-mix(in srgb, var(--accent) 35%, transparent));
  }

  .card__id { font-size: var(--step-1); font-weight: 700; text-align: center; }
  .card__user { color: var(--accent); }
  .card__at { color: var(--overlay0); }
  .card__host { color: var(--text); }

  .card__title {
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.1;
    text-align: center;
    margin: 0.5rem 0 0;
    text-wrap: balance;
  }
  .card__rule {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--surface1), transparent);
    margin: clamp(1rem, 3vw, 1.5rem) 0;
  }

  .card__specs { display: grid; gap: 0.7rem; }
  .card__row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.8rem;
    align-items: baseline;
    font-size: var(--step-0);
  }
  .card__row dt { color: var(--subtext); font-weight: 500; }
  .card__row dd { color: var(--text); }

  .card__quote {
    margin-top: auto;
    padding-top: clamp(1.2rem, 3vw, 1.8rem);
    color: var(--subtext);
    text-align: center;
    text-wrap: balance;
  }

  @media (max-width: 480px) {
    .card__row { grid-template-columns: 5rem 1fr; gap: 0.6rem; }
    .card::after { inset: 7px; }
  }
</style>

<script>
  // scale each ASCII/braille block to exactly fill its fixed square box,
  // so arts of any column/row count end up the same physical size.
  const fitAll = () => {
    document.querySelectorAll<HTMLPreElement>(".card__art .fit").forEach((pre) => {
      const box = pre.parentElement as HTMLElement;
      pre.style.transform = "scale(1)";
      const bw = box.clientWidth, bh = box.clientHeight;
      const pw = pre.offsetWidth, ph = pre.offsetHeight;
      if (pw && ph) pre.style.transform = `scale(${Math.min(bw / pw, bh / ph)})`;
    });
  };
  document.fonts?.ready.then(fitAll);
  fitAll();
  addEventListener("resize", fitAll);
</script>
